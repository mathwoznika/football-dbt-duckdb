# Copie para .env e ajuste. O compose le este arquivo sozinho.
#
# As credenciais tem valor padrao no docker-compose.yml, entao o projeto sobe
# sem nenhum .env — o arquivo existe para trocar a senha antes de expor o banco
# em qualquer lugar que nao seja a sua maquina.
# POSTGRES_DB=futebol
# POSTGRES_USER=futebol
# POSTGRES_PASSWORD=futebol

# Usadas pelo extrair.py, fora do compose.
# URL=https://v3.football.api-sports.io
# API-KEY=sua-chave
